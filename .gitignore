# dependencies
node_modules/

# build output
dist/
dist-ssr/

# local env files (Vite) — never commit per-machine/per-env secrets
.env
.env.local
.env.*.local
*.local

# logs
*.log
npm-debug.log*

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Palette drive screenshots (tools/palette-drive.mjs) — regenerated on demand
tools/.palette-shots/

# Grid theme drive screenshots (tools/grid-theme-drive.mjs) — same deal
tools/.grid-shots/

# StatusBadge drive screenshots (tools/status-badge-drive.mjs) — same deal
tools/.badge-shots/

# Delivery-channel drive screenshots (tools/ua-channel-drive.mjs) — same deal
tools/.channel-shots/

# Ua-users scale drive screenshots (tools/ua-users-scale-drive.mjs) — same deal
tools/.ua-scale-shots/

# AFK review reports (.afk/REVIEW-<ticket>.md) — written fresh by each wave's round-B
# reviewer, so a tracked one reads as "the reviewer edited the tree" and stops the loop.
# The HITL decision logs beside them ARE committed on purpose.
.afk/REVIEW-*.md
